# Copie para deploy/.env e troque os valores. Nunca versione o .env.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=troque-me
APP_MIGRATOR_PASSWORD=troque-me
APP_USER_PASSWORD=troque-me
# Storage S3 de dev (SeaweedFS)
S3_ACCESS_KEY=ecommerce
S3_SECRET_KEY=troque-me
# Cofre de segredos (RF06): chave mestra = 32 bytes em base64. Gere com: openssl rand -base64 32
VAULT_MASTER_KEY_V1=troque-me
# JWT do painel (RF07): 32+ bytes em base64. Gere com: openssl rand -base64 32
AUTH_SIGNING_KEY=troque-me
# Só dev: loja demo com este Dono (senha de 10+ caracteres). Deixe vazio para não criar.
DEV_OWNER_EMAIL=dono@demo.local
DEV_OWNER_PASSWORD=troque-me-123
# Domínio sob o qual as lojas nascem (<slug>.<domínio>). Dev: localhost (o Caddy emite certificado local).
PLATFORM_DOMAIN=localhost
# Melhor Envio (RF14): nome do aplicativo e e-mail técnico, exigidos pela API. Ex.: Plataforma (dev@exemplo.com.br)
MELHOR_ENVIO_USER_AGENT=
