root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

# Migrações são geradas pelo EF Core.
[src/Infrastructure/{Persistence,Platform}/Migrations/*.cs]
generated_code = true

# Testes usam nomes descritivos em português com sublinhados.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2007.severity = none
